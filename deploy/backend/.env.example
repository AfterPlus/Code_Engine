# Copy to .env (next to compose.yaml) and adjust.

# Hostname the proxy answers on. Must match the Cloudflare Origin certificate in ./certs.
API_DOMAIN=api.codeengine.co.in

# Sites allowed to call the API from the browser (comma-separated; * wildcards allowed).
# Add https://*.<project>.pages.dev to let Cloudflare Pages preview deployments use it too.
CORS_ALLOWED_ORIGINS=https://codeengine.co.in,https://www.codeengine.co.in

# Java runs at a time (more wait in a queue of 16, then HTTP 429). Sized for the 4-core / 24 GB Oracle free VM.
MAX_CONCURRENT=3
API_CPUS=3
API_MEMORY=3g
